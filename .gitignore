__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generated data. Raw/cleaned/rejects hold unmasked PII - never commit.
# All of it is reproducible: `python -m pipeline generate --seed 42`
data/raw/*
data/processed/*
data/rejects/*
!data/**/.gitkeep

# Deliverables are committed even though they carry unmasked PII, because the
# dataset is synthetic. Against production data neither would be, and the
# reproduction command below would be the only way to hand them over.
!data/processed/customers_masked.csv
!data/processed/customers_cleaned.csv

# Run log, regenerated every run
reports/pipeline.log
